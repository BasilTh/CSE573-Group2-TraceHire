# Copy this file to .env and fill in your own key. Never commit .env.
# ASU Research Computing API: make a key in the Voyager portal (Profile > Keys > Create API key).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openai.rc.asu.edu/v1

